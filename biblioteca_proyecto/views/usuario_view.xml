<odoo>
    <record id="view_biblioteca_usuario_list" model="ir.ui.view">
        <field name="name">biblioteca.usuario.list</field>
        <field name="model">biblioteca_proyecto.usuario</field>
        <field name="arch" type="xml">
            <list string="Usuarios">
                <field name="name"/>
                <field name="dni"/>
                <field name="email"/>
                <field name="telefono"/>
                <field name="fecha_registro"/>
            </list>
        </field>
    </record>
    
    <record id="view_biblioteca_usuario_form" model="ir.ui.view">
        <field name="name">biblioteca.usuario.form</field>
        <field name="model">biblioteca_proyecto.usuario</field>
        <field name="arch" type="xml">
            <form string="Usuario">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_prestamos" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-bars">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Ver Préstamos</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group string="Datos Personales">
                            <field name="name"/>
                            <field name="dni"/>
                        </group>
                        <group string="Contacto">
                            <field name="email"/>
                            <field name="telefono"/>
                            <field name="fecha_registro"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_biblioteca_usuario" model="ir.actions.act_window">
        <field name="name">Socios de la Biblioteca</field>
        <field name="res_model">biblioteca_proyecto.usuario</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Registra un nuevo socio
        </p>
            <p>
            Aquí podrás gestionar la información de contacto y ver sus préstamos.
        </p>
        </field>
    </record>

    <menuitem id="menu_biblioteca_usuarios" 
          name="Gestión de Usuarios" 
          parent="menu_biblioteca_root" 
          action="action_biblioteca_usuario" 
          sequence="20"/>

    
</odoo>