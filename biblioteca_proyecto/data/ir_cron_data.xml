<odoo>
    <data noupdate="1">
        <record id="ir_cron_check_retrasos_biblioteca" model="ir.cron">
            <field name="name">Biblioteca: Comprobar préstamos fuera de plazo</field>
            <field name="model_id" ref="model_biblioteca_proyecto_prestamo"/>
            <field name="state">code</field>
            <field name="code">model.run_check_retrasos_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(datetime.now().replace(hour=0, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>